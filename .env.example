# Copiar a .env y rellenar. NUNCA commitear .env.

# PostgreSQL (Neon) — ADR 001
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# SEC EDGAR — ADR 006 / 008
# Obligatorio: la SEC exige identificar al solicitante y responde 403 sin esta
# cabecera. Formato: "NombreProyecto contacto@ejemplo.com".
SEC_USER_AGENT=InvestingApp tu-correo@ejemplo.com

# FRED / ALFRED — ADR 007. Gratuita: https://fred.stlouisfed.org/docs/api/api_key.html
# Cierra MA-1 y MA-2, los bloqueantes más duros de la spec.
FRED_API_KEY=

# Twelve Data — ADR 001 / 002 (precios y consenso de earnings)
TWELVEDATA_API_KEY=

# Ingesta diaria (ADR 004). Cada día no capturado es un agujero permanente
# en el archivo de consenso: el consenso de ayer no se puede volver a observar.
DAILY_INGEST_CRON=0 3 * * *

# En este entorno el fetch de Node ignora las variables de proxy y recibe 403
# aunque el host esté permitido. Ver PROVIDER_EVALUATION.md §3.4.1.
#   NODE_USE_ENV_PROXY=1
#   HTTPS_PROXY=http://127.0.0.1:PUERTO
